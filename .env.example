# Configurações do Servidor Web (Visualizador)
WEB_HOST=0.0.0.0
WEB_PORT=1882

# Autenticação do Visualizador Web
WEB_AUTH_USER=admin
WEB_AUTH_PASSWORD=troque_esta_senha

# Configurações do Broker Mosquitto
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mqtt-web-visualizer
# Tópicos para monitorar (separados por vírgula). '#' monitora todos os tópicos.
MQTT_TOPICS=#

# TLS / SSL (opcional)
MQTT_USE_TLS=false
MQTT_TLS_INSECURE=false
MQTT_CA_CERTS=

# Retenção de canais ativos e histórico
RETENTION_HOURS=4
MAX_MESSAGES_PER_TOPIC=100
DB_PATH=data/mqtt_history.db
